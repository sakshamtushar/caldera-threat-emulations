# REQUIRED — path to Caldera root directory (unless DOCKER_MODE=true)
# Example: CALDERA_HOME=/home/user/caldera
CALDERA_HOME=

# ─── Docker Mode ─────────────────────────────────────────────────────────────
# Set to true to deploy into a Caldera Docker container instead of filesystem
DOCKER_MODE=false
DOCKER_CONTAINER=caldera-caldera-1
DOCKER_CALDERA_WORKDIR=/usr/src/app

# ─── Paths ──────────────────────────────────────────────────────────────────
# Subdirectory name for this plan's abilities inside Caldera's abilities dir
ABILITIES_DIR_NAME=axios-npm-supply-chain

# Caldera internal paths (usually don't need changing)
CALDERA_ABILITIES_PATH=data/abilities
CALDERA_ADVERSARIES_PATH=data/adversaries
