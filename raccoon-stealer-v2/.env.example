# =============================================================
# Caldera Deployment Configuration
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and will never be committed.
# =============================================================

# -------------------------------------------------------------
# REQUIRED (unless DOCKER_MODE=true)
# Path to your Caldera installation directory
# -------------------------------------------------------------
# Standard install:
#   CALDERA_HOME=/opt/caldera
# Custom install:
#   CALDERA_HOME=/home/user/caldera
CALDERA_HOME=

# -------------------------------------------------------------
# DOCKER MODE
# Set to true if Caldera runs inside a Docker container.
# When true, CALDERA_HOME is ignored.
# -------------------------------------------------------------
DOCKER_MODE=false

# Name of the running Caldera Docker container
# Find it with: docker ps | grep caldera
DOCKER_CONTAINER=caldera-caldera-1

# Internal Caldera working directory inside the container
# Default for standard caldera Docker image: /usr/src/app
DOCKER_CALDERA_WORKDIR=/usr/src/app

# -------------------------------------------------------------
# OPTIONAL — Caldera directory layout
# Only change these if your Caldera uses a non-standard layout
# -------------------------------------------------------------

# Subdirectory name created under abilities/ for this plan
ABILITIES_DIR_NAME=raccoon-stealer

# Paths relative to CALDERA_HOME (or DOCKER_CALDERA_WORKDIR)
CALDERA_ABILITIES_PATH=data/abilities
CALDERA_ADVERSARIES_PATH=data/adversaries
